		{ "action": "wait", "ms": 1500 },
		{ "action": "resetZoom" },
		{ "action": "wait", "ms": 3000 },

		{ "action": "hover", "target": "a[href='/inventory']" },
		{ "action": "pause" },
		{ "action": "click", "target": "a[href='/inventory']" },
		{ "action": "wait", "ms": 800 },
		{ "action": "waitFor", "target": "text:at or below the reorder point", "state": "visible", "timeout": 30000 },
		{ "action": "resume" },
		{ "action": "zoom", "level": 1.25, "origin": "text:at or below the reorder point" },
