		{ "action": "wait", "ms": 300 },
		{ "action": "hover", "target": "text:Save" },
		{ "action": "click", "target": "text:Save" },
		{ "action": "waitFor", "target": "text:at or below the reorder point", "state": "hidden", "timeout": 20000 },
		{ "action": "zoom", "level": 1.3, "origin": "tbody" },
		{ "action": "wait", "ms": 2000 },
		{ "action": "resetZoom" },
		{ "action": "wait", "ms": 1000 },

		{ "action": "hover", "target": "a[href='/products']" },
