		{ "action": "wait", "ms": 1500 },

		{ "action": "hover", "target": "a[href='/forecast']" },
		{ "action": "pause" },
		{ "action": "click", "target": "a[href='/forecast']" },
		{ "action": "waitFor", "target": "text:AI-driven demand prediction", "state": "visible", "timeout": 30000 },
		{ "action": "resume" },
		{ "action": "zoom", "level": 1.2, "origin": "text:AI-driven demand prediction" },
		{ "action": "wait", "ms": 1200 },
		{ "action": "resetZoom" },
		{ "action": "select", "target": "#product-select", "value": "a1b2c3d4-1111-4aaa-8bbb-111111111111" },
		{ "action": "waitFor", "target": ".recharts-surface", "state": "visible", "timeout": 30000 },
		{ "action": "wait", "ms": 5000 },

		{ "action": "hover", "target": "a[href='/developer']" },
		{ "action": "pause" },
		{ "action": "click", "target": "a[href='/developer']" },
		{ "action": "waitFor", "target": "text:Integrate with Vantage", "state": "visible", "timeout": 30000 },
		{ "action": "resume" },
		{ "action": "zoom", "level": 1.2, "origin": "text:Integrate with Vantage" },
		{ "action": "wait", "ms": 1500 },
		{ "action": "resetZoom" },
		{ "action": "wait", "ms": 3000 },

		{ "action": "hover", "target": "a[href='/']" },
		{ "action": "pause" },
		{ "action": "click", "target": "a[href='/']" },
		{ "action": "waitFor", "target": "text:Your operating picture", "state": "visible", "timeout": 30000 },
		{ "action": "resume" },
		{ "action": "wait", "ms": 4000 }
