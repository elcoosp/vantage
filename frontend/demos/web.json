{
	"$schema": "https://raw.githubusercontent.com/paragramagency/recordable/main/recordable.schema.json",
	"config": {
		"viewport": {
			"width": 1920,
			"height": 1080
		},
		"fps": 30,
		"headless": false,
		"typingSpeed": 12,
		"actionDelay": 450,
		"cursor": true,
		"zoomDuration": 400,
		"outputDir": "output",
		"outputName": "web"
	},
	"actions": [
		{ "action": "pause" },
		{ "action": "visit", "url": "http://localhost:5173/login" },
		{ "action": "waitFor", "target": "#email", "state": "visible", "timeout": 30000 },
		{ "action": "resume" },
		{ "action": "wait", "ms": 800 },
		{ "action": "zoom", "level": 1.2, "origin": "#email" },
		{ "action": "type", "target": "#email", "text": "admin@vantage.com" },
		{ "action": "type", "target": "#password", "text": "password123" },
		{ "action": "wait", "ms": 500 },
		{ "action": "resetZoom" },
		{ "action": "hover", "target": "form button[type='submit']" },
		{ "action": "pause" },
		{ "action": "click", "target": "form button[type='submit']" },

		{ "action": "waitFor", "target": "text:Your operating picture", "state": "visible", "timeout": 60000 },
		{ "action": "resume" },
		{ "action": "wait", "ms": 2000 },
		{ "action": "zoom", "level": 1.15, "origin": "text:Your operating picture" },
		{ "action": "wait", "ms": 2500 },
		{ "action": "resetZoom" },
		{ "action": "wait", "ms": 4000 },

